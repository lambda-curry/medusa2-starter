{
  "name": "medusa",
  "version": "0.0.1",
  "description": "A starter for Medusa projects.",
  "author": "Medusa (https://medusajs.com)",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "nukedb": "docker compose down -v && docker compose up -d --wait",
    "build": "medusa build",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "start": "medusa start",
    "dev": "medusa develop",
    "lint": "medusa lint",
    "sync": "medusa db:sync-links",
    "migrate:prod": "medusa db:migrate",
    "start:prod": "medusa start",
    "seed:prod": "medusa exec ./src/scripts/seed.js && yarn add-user:prod",
    "add-user:prod": "medusa user --email admin@medusa-test.com --password supersecret && medusa user --email admin@lambdacurry.dev --password password",
    "migrate": "medusa db:migrate",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit",
    "medusa:init": "yarn run nukedb && medusa db:create --db medusa2 && yarn run migrate && yarn run sync && yarn run seed && yarn run add-user",
    "add-user": "medusa user --email admin@medusa-test.com --password supersecret && medusa user --email admin@lambdacurry.dev --password password",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lambdacurry/medusa-product-reviews": "1.3.1",
    "@medusajs/admin-sdk": "2.17.1",
    "@medusajs/cli": "2.17.1",
    "@medusajs/framework": "2.17.1",
    "@medusajs/icons": "2.17.1",
    "@medusajs/js-sdk": "2.17.1",
    "@medusajs/medusa": "2.17.1",
    "@medusajs/types": "2.17.1",
    "@medusajs/ui": "4.1.18",
    "posthog-node": "5.11.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.17.1",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/express": "^4.17.13",
    "@types/jest": "^29.5.12",
    "@types/mime": "1.3.5",
    "@types/node": "^17.0.8",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "yalc": "^1.0.0-pre.53"
  },
  "resolutions": {
    "@lambdacurry/medusa-product-reviews/zod": "4.2.0"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "engines": {
    "node": ">=26"
  }
}
