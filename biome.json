{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.jsx",
      "!**/.turbo",
      "!**/yarn.lock",
      "!**/node_modules",
      "!**/apps/medusa/.medusa",
      "!**/apps/storefront/.react-router",
      "!**/build",
      "!**/dist",
      "!**/playwright-report",
      "!**/test-results"
    ]
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": false,
    "rules": {
      "style": {
        "useBlockStatements": "off",
        "useNamingConvention": "off",
        "noImplicitBoolean": "off",
        "noDefaultExport": "off",
        "noUnusedTemplateLiteral": "off",
        "useFilenamingConvention": "off",
        "noNonNullAssertion": "off",
        "useExplicitLengthCheck": "off"
      },
      "complexity": {
        "noForEach": "off",
        "useLiteralKeys": "off"
      },
      "performance": {
        "noAccumulatingSpread": "off"
      },
      "suspicious": {
        "noReactSpecificProps": "off",
        "noConsole": {
          "level": "off",
          "options": {
            "allow": [
              "log"
            ]
          }
        }
      },
      "correctness": {
        "noNodejsModules": "off",
        "noUndeclaredDependencies": "off",
        "useImportExtensions": "off"
      }
    }
  }
}
